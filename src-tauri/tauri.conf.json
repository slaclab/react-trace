{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "Trace",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {},
    "bundle": {
      "active": true,
      "category": "DeveloperTool",
      "copyright": "",
      "deb": {
        "depends": []
      },
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "edu.stanford.slac.trace",
      "longDescription": "",
      "resources": ["config.json", "../dist"],
      "shortDescription": "",
      "targets": "all",
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null
      },
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "cli": {
      "args": [
        {
          "name": "canopy-url",
          "takesValue": true,
          "description": "Canopy backend base URL (overrides env and bundled config.json)"
        },
        {
          "name": "api-key",
          "takesValue": true,
          "description": "X-API-Key value the proxy injects (overrides env and bundled config.json)"
        },
        {
          "name": "elog-key",
          "takesValue": true,
          "description": "X-API-Key value the proxy injects on Trace's e-log app path; defaults to the Canopy API key (overrides env and bundled config.json)"
        }
      ]
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    },
    "windows": []
  }
}
