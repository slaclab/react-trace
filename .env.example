# Canopy backend the dev server proxies to. Defaults to http://localhost:8000.
CANOPY_BASE_URL=http://localhost:8000

# API key the dev proxy injects as X-API-Key on requests to /mole/*. Must match a
# token registered in the backend's CANOPY_API_KEYS env var (e.g. CANOPY_API_KEYS=dev:read+write).
# Server-side env var (no VITE_ prefix), so it never reaches the browser bundle.
CANOPY_API_KEY=dev
