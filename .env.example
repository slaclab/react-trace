# Canopy backend the dev server proxies to. Defaults to http://localhost:8000.
CANOPY_BASE_URL=http://localhost:8000

# Public deployment settings. Leave unset for local dev. In the dev container,
# VITE_CANOPY_BASE_PATH is /trace/api/canopy: the container injects the API key
# and proxies it to the in-cluster Canopy service. When it is set, the dev proxy
# also serves that one prefix (stripped before forwarding) instead of /mole,
# /hare and /fox.
VITE_BASE_PATH=/
VITE_CANOPY_BASE_PATH=

# API key the dev proxy injects as X-API-Key on every Canopy request it forwards
# (/mole, /hare and /fox, HTTP and WebSocket). Must match a token registered in the
# backend's CANOPY_API_KEYS env var (e.g. CANOPY_API_KEYS=dev:read+write), scoped
# to all modules (@*) or to each of mole, hare and fox.
# Server-side env var (no VITE_ prefix), so it never reaches the browser bundle.
CANOPY_API_KEY=dev

# E-Log (elog-plus) microservice the dev server proxies /elog/* to. Leave unset to
# disable e-log posting (the toolbar button hides). e.g. http://localhost:8080
ELOG_BASE_URL=

# Application token the dev proxy injects as x-vouch-idp-accesstoken on /elog/*.
# Server-side env var (no VITE_ prefix), so it never reaches the browser bundle.
ELOG_API_KEY=

# Optional: header the e-log token is sent in, for an elog-plus behind a
# different auth proxy. Defaults to x-vouch-idp-accesstoken.
# ELOG_TOKEN_HEADER=

# Comma-separated logbook names preselected in the post dialog. Non-secret (VITE_).
VITE_ELOG_DEFAULT_LOGBOOKS=
