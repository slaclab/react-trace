# Canopy backend the dev server proxies to. Defaults to http://localhost:8000.
CANOPY_BASE_URL=http://localhost:8000

# Public deployment settings. Leave unset for local dev. In the dev container,
# VITE_CANOPY_BASE_PATH is /trace/api/canopy: the container injects the API key
# and proxies it to the in-cluster Canopy service. When it is set, the dev proxy
# also serves that one prefix (stripped before forwarding) instead of /mole,
# /hare and /formula-engine.
VITE_BASE_PATH=/
VITE_CANOPY_BASE_PATH=

# API keys the dev proxy injects as X-API-Key. Each must match a token registered
# in the backend's CANOPY_API_KEYS env var. Server-side env vars (no VITE_ prefix),
# so they never reach the browser bundle.
#
# CANOPY_API_KEY: /mole, /hare and /formula-engine. Read-only is enough (e.g. read@mole+hare+formula-engine).
CANOPY_API_KEY=dev

# CANOPY_ELOG_API_KEY: /elog/v1/apps/trace/, Trace's app in Canopy's e-log module,
# which needs read+write@elog. Other /elog paths aren't proxied.
# Kept separate because Canopy's write scope is per key: write on CANOPY_API_KEY
# would also allow PV writes through Hare. Leave unset to reuse CANOPY_API_KEY,
# which suits a local wildcard key such as CANOPY_API_KEYS=dev:read+write@*.
CANOPY_ELOG_API_KEY=
