# Canopy backend the dev server proxies to. Defaults to http://localhost:8000.
CANOPY_BASE_URL=http://localhost:8000

# Public deployment settings. Leave unset for local dev. In the dev container,
# VITE_CANOPY_BASE_PATH is /trace/api/canopy: the container injects the API key
# and proxies it to the in-cluster Canopy service.
VITE_BASE_PATH=/
VITE_CANOPY_BASE_PATH=

# Where the header's bug and help buttons go. Leave unset for this repo's GitHub
# issues and its public docs site. The image build takes them from the
# BUG_REPORT_URL and DOCS_URL repository variables.
VITE_BUG_REPORT_URL=
VITE_DOCS_URL=

# API keys the dev proxy injects as X-API-Key. Each must match a token registered
# in the backend's CANOPY_API_KEYS env var. Server-side env vars (no VITE_ prefix),
# so they never reach the browser bundle.
#
# CANOPY_API_KEY: /mole, /hare, /formula-engine, /magpie and /vole, e.g.
# read+write@mole+hare+formula-engine+magpie+vole. Saving workspaces to the config store
# (Magpie) needs write; Canopy's write scope is per key, so it also covers PV
# writes through Hare.
CANOPY_API_KEY=dev

# CANOPY_ELOG_API_KEY: /elog/v1/apps/trace/, Trace's app in Canopy's e-log module,
# which needs read+write@elog. Other /elog paths aren't proxied.
# Kept separate so e-log access stays on Trace's app path: Canopy doesn't bind
# keys to apps, so @elog on a key sent on every path could post as any app.
# Leave unset to reuse CANOPY_API_KEY, which suits a local wildcard key such as
# CANOPY_API_KEYS=dev:read+write@*.
CANOPY_ELOG_API_KEY=
