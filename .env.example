# Canopy backend the dev server proxies to. Defaults to http://localhost:8000.
CANOPY_BASE_URL=http://localhost:8000

# Public deployment settings. Leave unset for local dev. In the dev container,
# VITE_CANOPY_BASE_PATH is /trace/api/canopy: the container injects the API key
# and proxies it to the in-cluster Canopy service.
VITE_BASE_PATH=/
VITE_CANOPY_BASE_PATH=

# API key the dev proxy injects as X-API-Key on requests to /mole, /hare, /fox and
# /elog. Must match a token registered in the backend's CANOPY_API_KEYS env var,
# scoped to those modules (e.g. CANOPY_API_KEYS=dev:read+write@mole+hare+fox+elog).
# E-log posting needs write access and the elog module scope; Canopy holds the
# elog-plus token itself and decides whether posting is enabled for Trace.
# Server-side env var (no VITE_ prefix), so it never reaches the browser bundle.
CANOPY_API_KEY=dev
